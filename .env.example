# ===== Silelo 💯✨ — ตัวแปร Environment =====
# คัดลอกเป็น .env แล้วใส่ค่าจริง (หรือตั้งใน Render Dashboard)

# 🔑 JWT secret (สำคัญมาก เปลี่ยนเป็นค่ายาวๆ ของพี่บอสเอง)
JWT_SECRET=เปลี่ยนเป็นรหัสยาวๆ-สุ่มๆ-ห้ามซ้ำใคร

# 🤖 AI แชท — คีย์ OpenRouter (ฟรีโมเดล: gpt-oss-20b:free)
# ใส่ได้หลายคีย์ คั่นด้วยคอมม่า
OPENROUTER_API_KEY=sk-or-v1-xxx

# 🎨 AI สร้างภาพ — ลำดับ: Ideogram → OpenRouter Gemini → Pollinations (ฟรี)
IDEOGRAM_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# 👤 เจ้าของแอป (สลี่รับใช้ได้แค่คนนี้ — คนอื่นถูกปฏิเสธ)
AI_OWNER_EMAIL=demo@silelo.app

# 🐋 DeepSeek API (เติมเงินที่ platform.deepseek.com — ถูกมาก ~$0.27/1M คำ)
DEEPSEEK_API_KEY=กรอกคีย์จาก platform.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 🔊 ระบบเสียงสลี่
TTS_VOICE=th-TH-PremwadeeNeural
# 🎧 Whisper Large v3 (STT) — สมัครคีย์ฟรีที่ https://console.groq.com
GROQ_API_KEY=
